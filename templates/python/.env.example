# Local development only. Copy to `.env` and change values before sharing environments.
# Never commit real secrets, production credentials, or client data.

APP_ENV=local
APP_PORT=8000

POSTGRES_DB=customers
POSTGRES_USER=app
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=5432

# Used when the app gains persistence; current reference API is in-memory.
DATABASE_URL=postgresql://app:local-only-change-me@localhost:5432/customers
