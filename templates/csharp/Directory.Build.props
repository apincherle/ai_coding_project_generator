<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- NetAnalyzers ship in-box with the SDK. EnableNETAnalyzers plus AnalysisLevel/AnalysisMode
         turn on the recommended rule set without adding a separate NuGet package. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Reproducible restores: generate packages.lock.json with a locked restore, then commit it.
         CI and hooks use locked-mode restore so restores stay pinned once the lock file exists. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- NuGet Audit fails restore on known-vulnerable direct and transitive packages. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
