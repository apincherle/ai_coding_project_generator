# Local development only. Copy to `.env` and change values before sharing environments.
# Never commit real secrets, production credentials, or client data.

ASPNETCORE_ENVIRONMENT=Development
APP_PORT=8080

POSTGRES_DB=customers
POSTGRES_USER=app
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=5432

# Used when the app gains EF Core persistence; current reference API is in-memory.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=customers;Username=app;Password=local-only-change-me
